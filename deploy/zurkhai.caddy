# Installed as /opt/caddy-sites/zurkhai.caddy; imported by the shared Caddy (Bitdefender's stack).
# Caddy sets X-Forwarded-For to the connecting client (it trusts no upstream proxy), which is the
# one hop the app trusts (src/server/auth/index.ts → ipAddressHeaders).
acyy.me {
	encode zstd gzip
	reverse_proxy zurkhai-web:3000
}

# Old addresses of the same site.
www.acyy.me, zurkhai.2-28-197-187.sslip.io {
	redir https://acyy.me{uri} permanent
}

# Installed as /opt/caddy-sites/zurkhai.caddy; imported by the shared Caddy (Bitdefender's stack).
# Caddy sets X-Forwarded-For to the connecting client (it trusts no upstream proxy), which is the
# one hop the app trusts (src/server/auth/index.ts → ipAddressHeaders).
acyy.me {
	encode zstd gzip
	# Both web processes (docker-compose.prod.yml, replicas: 2). ip_hash keeps a client IP on one
	# process (in-memory rate limits); a process that fails is skipped for 30 s and the request
	# is retried on the other, so a restart of one doesn't drop requests.
	reverse_proxy zurkhai-web-1:3000 zurkhai-web-2:3000 {
		lb_policy ip_hash
		lb_try_duration 5s
		lb_try_interval 250ms
		fail_duration 30s
	}
}

# Old addresses of the same site.
www.acyy.me, zurkhai.2-28-197-187.sslip.io {
	redir https://acyy.me{uri} permanent
}

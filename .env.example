# ---- App ----
APP_NAME="Зурхай"
APP_URL=http://localhost:3000            # prod: https://2-28-197-187.sslip.io → later the real domain

# ---- Database ----
# docker compose: postgres://postgres:postgres@localhost:5432/zurkhai
# no Docker (pnpm db:local, PGlite): postgres://postgres:postgres@127.0.0.1:54320/postgres
DATABASE_URL=postgres://postgres:postgres@localhost:5432/zurkhai
DATABASE_POOL_MAX=10                     # pnpm db:local (PGlite): must be 1
POSTGRES_PASSWORD=                       # production only (docker-compose.prod.yml): openssl rand -hex 32

# ---- Auth (Better Auth) ----
BETTER_AUTH_SECRET=                      # openssl rand -base64 32
AUTH_PASSWORD_ENABLED=true               # prod: false
SEED_PASSWORD=                           # password for seeded test accounts (dev only)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
ADMIN_OWNER_EMAILS=owner@test.local      # comma-separated
ADMIN_EDITOR_EMAILS=editor@test.local    # comma-separated

# ---- Email ----
EMAIL_TRANSPORT=smtp                     # smtp (Mailpit) | resend | console (log + /dev/mail)
SMTP_URL=smtp://localhost:1025
RESEND_API_KEY=
EMAIL_FROM="Зурхай <no-reply@localhost>"

# ---- QPay ----
QPAY_MODE=mock                           # mock | sandbox | production
QPAY_CLIENT_ID=
QPAY_CLIENT_SECRET=
QPAY_INVOICE_CODE=
QPAY_BASE_URL=                           # sandbox: https://merchant-sandbox.qpay.mn, prod: https://merchant.qpay.mn
QPAY_CALLBACK_SECRET=                    # openssl rand -hex 32
ALLOW_QPAY_MOCK=                         # staging only: 1 = no warning for QPAY_MODE=mock in a production build

# ---- Cron ----
CRON_SECRET=                             # openssl rand -hex 32

# ---- Settings ----
SETTINGS_ENCRYPTION_KEY=                 # openssl rand -hex 32 — seals AI API keys saved on /admin/ai; changing it means re-entering them
